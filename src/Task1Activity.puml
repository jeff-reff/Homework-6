@startuml
'https://plantuml.com/activity-diagram-beta
title School Facility Rental - Activity

|Renter|
start
:Choose facility and date;

|Website|
:Check availability;
if (available?) then (yes)
:Create request;
else (no)
:Show not available;
stop
endif

:Enter contact info;
:Submit request;

|School Staff|
if (Review request) then (approved)
|Payment Service|
:Charge renter;
if (Payment) then (payment succeeds)
|Website|
:Save booking;
|Email Service|
:Send confirmation email;
:End (booking confirmed);
stop
else (payment fails)
|Website|
:Record payment failure;

|Email Service|
:Email renter about payment failure;
:End (payment failed);
stop
endif
else (rejected)
|Website|
:Record rejection;
|Email Service|
:Email renter;
:End (rejected);
stop
endif

@enduml
